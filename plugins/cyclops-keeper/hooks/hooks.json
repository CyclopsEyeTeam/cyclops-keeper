{
  "description": "Decorative activity observer: writes only local state, returns no decisions or context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${PLUGIN_ROOT}/scripts/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
